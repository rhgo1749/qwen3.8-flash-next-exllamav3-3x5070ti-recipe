#!/usr/bin/env bash
# Promoted environment for the validated 3x RTX 5070 Ti recipe.

# Freeze expert placement using a workload-trained routing histogram.
export EXL3_MOE_CPU_SWAP=0
export EXL3_MOE_CPU_SPLIT_STATS="/absolute/path/to/qwen38-routing-stats.json"

# Winning controlled C3 kernel policy on the validated host.
export EXL3_MGEMM_N_THRESHOLD=2048
export EXL3_INT8_GEMV=0

# Keep CPU-resident MoE weights in pinned host memory so prefill can DMA them
# directly without an extra pageable->pinned staging copy. This is intended
# to reduce PP/TTFT cost; it should not materially change steady-state TG.
export EXL3_MOE_PINNED_ARENA=1

# Keep EXL3_MOE_COOP_WIDE unset. A 2026-09-24 live A/B on this host strongly
# regressed decode when wide geometry was forced; let ExLlamaV3 choose geometry.

# Promoted host-memory safety margin for the SSD-PLE profile.
# 64 GB is the recommended minimum with this 8 GiB reserve; 128 GB is the directly validated host.
export EXL3_HOST_MEM_RESERVE_MB=8192

# Optional/diagnostic variables used during the original experiments.
# export EXL3_MOE_HANDOFF_PROF=1
# export EXL3_MOE_CPU_PROF=1
# export EXL3_MOE_HIST_PROBE=1
# export EXL3_MOE_HIST_OUT="/absolute/path/to/qwen38-routing-stats.json"
