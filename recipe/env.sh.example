#!/usr/bin/env bash
# Promoted environment for the validated 3x RTX 5070 Ti recipe.

# Freeze expert placement using a workload-trained routing histogram.
export EXL3_MOE_CPU_SWAP=0
export EXL3_MOE_CPU_SPLIT_STATS="/absolute/path/to/qwen38-routing-stats.json"

# Winning controlled C3 kernel policy on the validated host.
export EXL3_MGEMM_N_THRESHOLD=2048
export EXL3_INT8_GEMV=0

# Optional/diagnostic variables used during the original experiments.
# export EXL3_MOE_HANDOFF_PROF=1
# export EXL3_MOE_CPU_PROF=1
# export EXL3_MOE_HIST_PROBE=1
# export EXL3_MOE_HIST_OUT="/absolute/path/to/qwen38-routing-stats.json"
